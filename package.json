{
  "name": "gas-template",
  "version": "1.0.0",
  "description": "Template for Google Apps Script",
  "scripts": {
    "prepare": "failsafe prepare:lefthook",
    "prepare:lefthook": "lefthook install",
    "lint": "eslint --fix",
    "lint:all": "pnpm run lint \"**/*.{ts,mts,js,mjs}\"",
    "format": "prettier --write",
    "format:all": "pnpm run format \"**/*.{ts,mts,js,mjs}\"",
    "login": "clasp login --status",
    "create": "clasp create --rootDir dist",
    "clone": "clasp clone --rootDir dist",
    "open": "clasp open -P dist/.clasp.json",
    "clean": "rimraf dist/*.js dist/appsscript.json",
    "prebuild": "failsafe lint:all format:all clean",
    "build": "vite build",
    "prepush": "failsafe build",
    "push": "clasp push -P dist/.clasp.json",
    "pull": "clasp pull -P dist/.clasp.json",
    "version": "clasp version -P dist/.clasp.json $(git rev-parse --short=7 HEAD)",
    "version:list": "clasp versions -P dist/.clasp.json",
    "deploy": "clasp deploy -P dist/.clasp.json",
    "deploy:list": "clasp deployments -P dist/.clasp.json",
    "invoke": "clasp run -P dist/.clasp.json",
    "test": "vitest run"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyoppomu/gas-template.git"
  },
  "keywords": [
    "GAS"
  ],
  "author": "Yuki Yoshida <yuki.yoshida@access-company.com> (https://jyoppomu.github.io/tips/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jyoppomu/gas-template/issues"
  },
  "homepage": "https://github.com/jyoppomu/gas-template#readme",
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@google/clasp": "2.5.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/google-apps-script": "1.0.100",
    "@types/node": "22.20.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "gas-entry-generator": "3.0.0",
    "globals": "16.5.0",
    "lefthook": "2.1.14",
    "npm-failsafe": "1.4.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "rollup": "4.63.3",
    "rollup-pluginutils": "2.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.26.0"
}
